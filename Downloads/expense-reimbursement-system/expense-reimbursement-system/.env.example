# Server
PORT=4000
NODE_ENV=development

# Database (SQLite by default for zero-setup evaluation; swap to Postgres for production - see README)
DATABASE_URL="./data/dev.sqlite"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Company base currency - all reports/summaries roll up into this currency
BASE_CURRENCY="USD"
